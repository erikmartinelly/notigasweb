# Normalizacion de fin de linea. Sin esto, core.autocrlf=true marca como
# modificados decenas de archivos que en realidad no cambiaron, ensuciando
# el diff y el historial.
* text=auto eol=lf

# Migraciones SQL: se guardan siempre en LF.
*.sql text eol=lf

# Documentacion y scripts de shell.
*.md text eol=lf
*.sh text eol=lf

# Windows mantiene CRLF en scripts de PowerShell.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios: nunca tocar.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.mp4 binary
*.webm binary
