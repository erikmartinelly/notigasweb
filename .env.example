# Public browser credentials injected by server.js at runtime.
# Never put SUPABASE_SERVICE_ROLE_KEY in this application.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional browser error monitoring. Leave empty to disable Sentry entirely.
SENTRY_DSN=
NODE_ENV=production

# HTTP port. Most hosts inject PORT automatically; SERVER_PORT is accepted as a
# fallback. Defaults to 3000 when neither is set. The server always binds 0.0.0.0
# so it is reachable from outside a container.
PORT=3000
SERVER_PORT=3000
