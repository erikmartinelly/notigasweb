# Public browser credentials injected by server.js at runtime.
# These values are public-facing and must still be supplied by the hosting environment.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in this application.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional browser error monitoring. Leave empty to disable Sentry.
SENTRY_DSN=
NODE_ENV=production
